# ===== REQUIRED =====

# From @BotFather on Telegram (README step 2)
TELEGRAM_TOKEN=

# Your Anthropic API key (Brooks: same one your bots use, from console.anthropic.com)
ANTHROPIC_API_KEY=

# The secret word she texts the bot ONCE to claim it as hers. Pick anything.
PAIRING_CODE=letmein

# ===== PERSONALITY & TIMING (all optional) =====

# What the assistant calls itself
ASSISTANT_NAME=Penny

# Her timezone
# Leave blank to auto-use this Mac's timezone
TIMEZONE=

# Owner pronouns (all optional — defaults below match the original Penny wording,
# so existing installs need to change nothing). Only he/she are fully supported;
# a "they" owner needs OWNER_POSS_PRED reviewed by hand (singular-they verb
# agreement isn't handled in the prompt).
# OWNER_PRONOUN_SUBJ=she   # she / he / they
# OWNER_PRONOUN_OBJ=her    # her / him / them
# OWNER_PRONOUN_POSS=her   # her / his / their  (determiner: "her list")
# OWNER_POSS_PRED=hers     # hers / his / theirs (predicate: "all hers to set")

# One sentence framing what this owner struggles with and why this assistant
# helps. Default (below, commented out) is Penny's original anxiety-specific
# framing — override for an owner whose actual challenge is different (see
# instances/jarvis/.env for an example).
# OWNER_FRAME=Her anxiety comes from holding everything in her head; your job is to hold it for her, reliably and calmly.

# Daily digest times (24h clock)
MORNING_DIGEST=08:00
EVENING_DIGEST=20:30

# No reminder pings between these hours (except priority-5 emergencies)
QUIET_START_HOUR=22
QUIET_END_HOUR=8

# How often to check her inbox, in minutes (only when Google is connected)
EMAIL_POLL_MINUTES=15

# ===== MODELS & COST (defaults are fine) =====
# Everyday turns run on Haiku (cheap); Sonnet only for decisions/planning/photos.
# Set SMART_ROUTING=0 to always use the big model.
# For an all-Haiku system (max savings): BRAIN_MODEL=claude-haiku-4-5-20251001
BRAIN_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
SMART_ROUTING=1
# Soft daily spend cap: past this, everything falls back to Haiku (she never loses service)
DAILY_BUDGET_USD=0.20
# Hard daily stop: past this, nothing calls the API until midnight (reminders,
# buttons, and plain-text digests keep working free)
HARD_CAP_USD=0.25
